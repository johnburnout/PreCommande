{
    "name": "precommande/wp-precommande",
    "description": "Plugin WordPress de sondage / précommande de vêtements et d'objets",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/validator": "^6.4",
        "yahnis-elsts/plugin-update-checker": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "PreCommande\\": "src/"
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "sh -c 'test -f ./bin/strauss.phar || (mkdir -p bin && curl -fsSL -o bin/strauss.phar https://github.com/BrianHenryIE/strauss/releases/latest/download/strauss.phar)'",
            "@php bin/strauss.phar",
            "@composer dump-autoload --optimize"
        ],
        "post-install-cmd": ["@prefix-namespaces"],
        "post-update-cmd": ["@prefix-namespaces"]
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "PreCommande\\Vendor\\",
            "classmap_prefix": "PreCommande_Vendor_",
            "constant_prefix": "PRECOMMANDE_VENDOR_",
            "delete_vendor_packages": true,
            "exclude_from_prefix": {
                "packages": [
                    "symfony/polyfill-ctype",
                    "symfony/polyfill-mbstring",
                    "symfony/polyfill-php83",
                    "symfony/deprecation-contracts"
                ]
            },
            "exclude_from_copy": {
                "packages": [
                    "yahnis-elsts/plugin-update-checker"
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
